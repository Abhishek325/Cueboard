{
  "name": "cueboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vue content planner with Dexie IndexedDB and optional YouTube integration",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8775 --strictPort",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8776 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "deploy:pages": "npm run check && gh-pages --dist dist --branch gh-pages --dotfiles --nojekyll --message \"Publish Cueboard production build\""
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vue/test-utils": "^2.4.0",
    "fake-indexeddb": "^6.2.0",
    "fflate": "^0.8.2",
    "gh-pages": "6.1.1",
    "happy-dom": "^20.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
